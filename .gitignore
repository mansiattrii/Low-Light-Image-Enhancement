# Environments
.venv/
venv/
.env

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Data: the dataset is downloaded manually; only the validation split list is tracked
data/*
!data/splits/

# Training artifacts: only the final weights in weights/ are tracked.
# Files already committed under checkpoints/ stay tracked; new runs are ignored.
checkpoints/
runs/
lightning_logs/
wandb/
mlruns/
*.ckpt
*.pt
weights/*
!weights/.gitkeep
!weights/zerodce.pth
!weights/zerodce_e045.pth
!weights/zerodce_paper.pth

